+#!/usr/bin/env python3
+"""Run the direct Bailian PoC; keep remote credentials in process memory only."""
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parent.parent
+args = sys.argv[1:]
+env = os.environ.copy()
+env["WARP_DIRECT_BAILIAN"] = "1"
+env["WARP_SKIP_COMMON_SKILLS_INSTALL"] = "1"
+
+if "--from-dev1" in args:
+    args.remove("--from-dev1")
+    remote = r'''
+import json, pathlib, shlex
+values = {}
+for raw in (pathlib.Path.home() / ".env").read_text().splitlines():
+    line = raw.strip()
+    if line.startswith("export "):
+        line = line[7:]
+    key, sep, value = line.partition("=")
+    if sep and key.strip() == "LLM_API_KEY":
+        parts = shlex.split(value, comments=True)
+        values["LLM_API_KEY"] = parts[0] if parts else ""
+if not values.get("LLM_API_KEY"):
+    raise SystemExit("LLM_API_KEY missing in dev1 ~/.env")
+print(json.dumps(values))
+'''
+    result = subprocess.run(["ssh", "dev1", "python3", "-"], input=remote, text=True, capture_output=True)
+    if result.returncode:
+        raise SystemExit("Unable to load LLM_API_KEY from dev1 ~/.env; check SSH and the remote file.")
+    env.update(json.loads(result.stdout))
+
+if "--no-build" in args:
+    args.remove("--no-build")
+    if args:
+        raise SystemExit("--no-build accepts only --from-dev1")
+    if sys.platform != "darwin":
+        raise SystemExit("--no-build currently supports the macOS debug app bundle only.")
+    metadata = subprocess.run(
+        ["cargo", "metadata", "--no-deps", "--locked", "--format-version", "1"],
+        cwd=root,
+        env=env,
+        text=True,
+        capture_output=True,
+        check=True,
+    )
+    target_dir = Path(json.loads(metadata.stdout)["target_directory"])
+    executable = target_dir / "debug/bundle/osx/WarpOss.app/Contents/MacOS/warp-oss"
+    if not executable.is_file():
+        raise SystemExit("Build WarpOss.app before using --no-build.")
+    command = [str(executable)]
+elif "--smoke" in args:
+    args.remove("--smoke")
+    if args:
+        raise SystemExit("--smoke accepts only --from-dev1")
+    if not env.get("LLM_API_KEY"):
+        raise SystemExit("Set LLM_API_KEY or use --from-dev1 for the standalone smoke test.")
+    command = ["cargo", "run", "-p", "warp_bailian_client", "--example", "smoke"]
+else:
+    command = [str(root / "script" / "run"), *args]
+
+os.chdir(root)
+os.execvpe(command[0], command, env)
