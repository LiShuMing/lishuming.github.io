+++ b/app/src/ai/direct_bailian.rs
@@ -0,0 +1,44 @@
+//! Explicit, process-scoped opt-in to the text-only direct inference PoC.
+
+use ai::api_keys::ApiKeyManager;
+use warp_bailian_client::{BASE_URL, Config};
+use warpui::{AppContext, SingletonEntity};
+
+use crate::ai::blocklist::RequestInput;
+
+pub(crate) fn is_enabled() -> bool {
+    !cfg!(target_family = "wasm")
+        && std::env::var("WARP_DIRECT_BAILIAN").is_ok_and(|value| value == "1")
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct DirectBailianRequest {
+    pub config: Config,
+    pub task_id: String,
+}
+
+impl DirectBailianRequest {
+    pub fn snapshot(input: &RequestInput, ctx: &AppContext) -> Option<Self> {
+        is_enabled().then(|| {
+            let api_key = std::env::var("LLM_API_KEY")
+                .ok()
+                .filter(|key| !key.trim().is_empty())
+                .or_else(|| {
+                    ApiKeyManager::as_ref(ctx)
+                        .custom_endpoints()
+                        .iter()
+                        .find(|endpoint| endpoint.url.trim_end_matches('/') == BASE_URL)
+                        .map(|endpoint| endpoint.api_key.clone())
+                })
+                .unwrap_or_default();
+            Self {
+                config: Config::new(api_key),
+                task_id: input
+                    .input_messages
+                    .first()
+                    .map(|(task_id, _)| task_id.to_string())
+                    .unwrap_or_default(),
+            }
+        })
+    }
+}
