+//! Text-only Bailian inference translated into Warp's native response events.
+
+use std::fmt;
+#[cfg(not(target_family = "wasm"))]
+use std::time::Duration;
+use std::time::SystemTime;
+
+use futures::StreamExt;
+use serde_json::{Value, json};
+use uuid::Uuid;
+use warp_multi_agent_api::client_action::{
+    Action, AddMessagesToTask, AppendToMessageContent, CreateTask,
+};
+use warp_multi_agent_api::message::{AgentOutput, Message as MessageKind, UserQuery};
+use warp_multi_agent_api::response_event::{
+    ClientActions, StreamFinished, StreamInit, Type, stream_finished,
+};
+use warp_multi_agent_api::{ClientAction, Message, ResponseEvent, Task};
+
+pub const BASE_URL: &str = "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1";
+pub const MODEL: &str = "deepseek-v4.1-flash";
+const MAX_EVENT_BYTES: usize = 1024 * 1024;
+
+#[cfg(not(target_family = "wasm"))]
+pub type OutputStream = futures::stream::BoxStream<'static, Result<ResponseEvent, Error>>;
+#[cfg(target_family = "wasm")]
+pub type OutputStream = futures::stream::LocalBoxStream<'static, Result<ResponseEvent, Error>>;
+
+#[derive(Clone)]
+pub struct Config {
+    api_key: String,
+}
+
+impl Config {
+    pub fn new(api_key: String) -> Self {
+        Self { api_key }
+    }
+}
+
+impl fmt::Debug for Config {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("BailianConfig").finish_non_exhaustive()
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("Bailian API key is missing. Configure the Token Plan endpoint or set LLM_API_KEY.")]
+    MissingKey,
+    #[error("Bailian PoC supports plain text conversations only; start a new conversation.")]
+    UnsupportedHistory,
+    #[error("Bailian PoC requires a non-empty text prompt.")]
+    EmptyPrompt,
+    #[error("Bailian HTTP {0}; check the API key, Token Plan quota and model access.")]
+    Http(u16),
+    #[error("Bailian network request failed.")]
+    Network,
+    #[error("Bailian returned an invalid streaming response.")]
+    InvalidStream,
+    #[error("Bailian stream ended before [DONE]. Retry the prompt manually.")]
+    UnexpectedEof,
+    #[error("Bailian returned a tool call; tools are disabled in this PoC.")]
+    ToolCall,
+    #[error("Bailian response exceeded the output token limit.")]
+    TokenLimit,
+    #[error("Bailian rejected the request or returned an unsupported finish reason.")]
+    Provider,
+}
+
+/// Opens one model turn. Dropping this stream cancels the HTTP request; it never retries.
+pub fn generate(
+    config: Config,
+    task_id: String,
+    tasks: Vec<Task>,
+    queries: Vec<String>,
+) -> OutputStream {
+    generate_at(
+        config,
+        task_id,
+        tasks,
+        queries,
+        format!("{BASE_URL}/chat/completions"),
+    )
+}
+
+fn request_body(tasks: &[Task], queries: &[String]) -> Result<Value, Error> {
+    let mut messages = vec![json!({
+        "role": "system",
+        "content": "You are a helpful assistant in Warp. Answer in the user's language. You can only respond with text; you cannot execute commands, access files, or call tools."
+    })];
+    if tasks.len() > 1 {
+        return Err(Error::UnsupportedHistory);
+    }
+    for task in tasks {
+        for message in &task.messages {
+            let (role, content) = match message.message.as_ref() {
+                Some(MessageKind::UserQuery(query)) => ("user", query.query.as_str()),
+                Some(MessageKind::AgentOutput(output)) => ("assistant", output.text.as_str()),
+                Some(MessageKind::AgentReasoning(_) | MessageKind::ModelUsed(_)) | None => continue,
+                Some(_) => return Err(Error::UnsupportedHistory),
+            };
+            if !content.is_empty() {
+                messages.push(json!({"role": role, "content": content}));
+            }
+        }
+    }
+    if queries.is_empty() || queries.iter().any(|query| query.trim().is_empty()) {
+        return Err(Error::EmptyPrompt);
+    }
+    for query in queries {
+        messages.push(json!({"role": "user", "content": query}));
+    }
+    Ok(json!({
+        "model": MODEL,
+        "messages": messages,
+        "stream": true,
+        "stream_options": {"include_usage": true},
+        "enable_thinking": false,
+        "max_tokens": 2048
+    }))
+}
+
+fn generate_at(
+    config: Config,
+    task_id: String,
+    tasks: Vec<Task>,
+    queries: Vec<String>,
+    url: String,
+) -> OutputStream {
+    Box::pin(async_stream::try_stream! {
+        if config.api_key.trim().is_empty() {
+            Err(Error::MissingKey)?;
+        }
+        let body = request_body(&tasks, &queries)?;
+        let builder = reqwest::Client::builder();
+        #[cfg(not(target_family = "wasm"))]
+        let builder = builder.timeout(Duration::from_secs(120)).redirect(reqwest::redirect::Policy::none());
+        let client = builder.build().map_err(|_| Error::Network)?;
+        let response = client.post(url)
+            .bearer_auth(&config.api_key)
+            .header("Accept", "text/event-stream")
+            .json(&body)
+            .send().await.map_err(|_| Error::Network)?;
+        if !response.status().is_success() {
+            Err(Error::Http(response.status().as_u16()))?;
+        }
+        if !response.headers().get("content-type")
+            .and_then(|value| value.to_str().ok())
+            .is_some_and(|value| value.starts_with("text/event-stream")) {
+            Err(Error::InvalidStream)?;
+        }
+
+        let request_id = Uuid::new_v4().to_string();
+        let message_id = Uuid::new_v4().to_string();
+        let message = |id: String, kind| Message {
+            id,
+            task_id: task_id.clone(),
+            request_id: request_id.clone(),
+            timestamp: Some(prost_types::Timestamp::from(SystemTime::now())),
+            message: Some(kind),
+            ..Default::default()
+        };
+        yield ResponseEvent { r#type: Some(Type::Init(StreamInit {
+            request_id: request_id.clone(),
+            ..Default::default()
+        })) };
+        let mut actions = Vec::new();
+        if tasks.is_empty() {
+            actions.push(Action::CreateTask(CreateTask {
+                task: Some(Task { id: task_id.clone(), ..Default::default() }),
+            }));
+        }
+        let mut messages: Vec<_> = queries.into_iter().map(|query| {
+            message(Uuid::new_v4().to_string(), MessageKind::UserQuery(UserQuery {
+                query, ..Default::default()
+            }))
+        }).collect();
+        messages.push(message(message_id.clone(), MessageKind::AgentOutput(AgentOutput {
+            text: String::new(),
+        })));
+        actions.push(Action::AddMessagesToTask(AddMessagesToTask { task_id: task_id.clone(), messages }));
+        yield client_actions(actions);
+
+        let mut decoder = SseDecoder::default();
+        let mut chunks = response.bytes_stream();
+        let mut stopped = false;
+        let mut done = false;
+        while let Some(chunk) = chunks.next().await {
+            let chunk = chunk.map_err(|_| Error::Network)?;
+            for data in decoder.push(&chunk)? {
+                match decode_delta(&data)? {
+                    Delta::Text(text) => {
+                        if stopped { Err(Error::InvalidStream)?; }
+                        yield client_actions(vec![Action::AppendToMessageContent(AppendToMessageContent {
+                            task_id: task_id.clone(),
+                            message: Some(message(message_id.clone(), MessageKind::AgentOutput(AgentOutput { text }))),
+                            mask: Some(prost_types::FieldMask { paths: vec!["agent_output.text".to_owned()] }),
+                        })]);
+                    }
+                    Delta::Stop(text) => {
+                        if stopped { Err(Error::InvalidStream)?; }
+                        if !text.is_empty() {
+                            yield client_actions(vec![Action::AppendToMessageContent(AppendToMessageContent {
+                                task_id: task_id.clone(),
+                                message: Some(message(message_id.clone(), MessageKind::AgentOutput(AgentOutput { text }))),
+                                mask: Some(prost_types::FieldMask { paths: vec!["agent_output.text".to_owned()] }),
+                            })]);
+                        }
+                        stopped = true;
+                    }
+                    Delta::Done => { done = true; break; }
+                    Delta::Ignore => {}
+                }
+            }
+            if done { break; }
+        }
+        if !done || !stopped { Err(Error::UnexpectedEof)?; }
+        yield ResponseEvent { r#type: Some(Type::Finished(StreamFinished {
+            reason: Some(stream_finished::Reason::Done(stream_finished::Done {})),
+            ..Default::default()
+        })) };
+    })
+}
+
+fn client_actions(actions: Vec<Action>) -> ResponseEvent {
+    ResponseEvent {
+        r#type: Some(Type::ClientActions(ClientActions {
+            actions: actions
+                .into_iter()
+                .map(|action| ClientAction {
+                    action: Some(action),
+                })
+                .collect(),
+        })),
+    }
+}
+
+#[derive(Debug, PartialEq)]
+enum Delta {
+    Text(String),
+    Stop(String),
+    Done,
+    Ignore,
+}
+
+fn decode_delta(data: &str) -> Result<Delta, Error> {
+    if data.trim() == "[DONE]" {
+        return Ok(Delta::Done);
+    }
+    let value: Value = serde_json::from_str(data).map_err(|_| Error::InvalidStream)?;
+    if value.get("error").is_some() {
+        return Err(Error::Provider);
+    }
+    let choices = value["choices"].as_array().ok_or(Error::InvalidStream)?;
+    if choices.is_empty() {
+        return Ok(Delta::Ignore);
+    }
+    if choices.len() != 1 || choices[0]["index"] != 0 {
+        return Err(Error::InvalidStream);
+    }
+    let choice = &choices[0];
+    let delta = &choice["delta"];
+    if delta.get("tool_calls").is_some() || delta.get("function_call").is_some() {
+        return Err(Error::ToolCall);
+    }
+    let content = match delta.get("content") {
+        None | Some(Value::Null) => String::new(),
+        Some(Value::String(text)) => text.clone(),
+        Some(_) => return Err(Error::InvalidStream),
+    };
+    match choice["finish_reason"].as_str() {
+        Some("stop") => Ok(Delta::Stop(content)),
+        Some("length") => Err(Error::TokenLimit),
+        Some("tool_calls" | "function_call") => Err(Error::ToolCall),
+        Some(_) => Err(Error::Provider),
+        None if content.is_empty() => Ok(Delta::Ignore),
+        None => Ok(Delta::Text(content)),
+    }
+}
+
+#[derive(Default)]
+struct SseDecoder {
+    line: Vec<u8>,
+    data: Vec<String>,
+    event_bytes: usize,
+}
+
+impl SseDecoder {
+    fn push(&mut self, chunk: &[u8]) -> Result<Vec<String>, Error> {
+        let mut events = Vec::new();
+        for &byte in chunk {
+            self.event_bytes += 1;
+            if self.event_bytes > MAX_EVENT_BYTES {
+                return Err(Error::InvalidStream);
+            }
+            if byte != b'\n' {
+                self.line.push(byte);
+                continue;
+            }
+            let line = std::str::from_utf8(&self.line).map_err(|_| Error::InvalidStream)?;
+            let line = line.strip_suffix('\r').unwrap_or(line);
+            if line.is_empty() {
+                if !self.data.is_empty() {
+                    events.push(self.data.join("\n"));
+                    self.data.clear();
+                }
+                self.event_bytes = 0;
+            } else if let Some(data) = line.strip_prefix("data:") {
+                self.data
+                    .push(data.strip_prefix(' ').unwrap_or(data).to_owned());
+            }
+            self.line.clear();
+        }
+        Ok(events)
+    }
+}
