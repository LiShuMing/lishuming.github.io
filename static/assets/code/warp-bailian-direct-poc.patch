+use futures::StreamExt;
+use instant::Instant;
+use warp_bailian_client::{Config, MODEL, generate};
+use warp_multi_agent_api::Task;
+use warp_multi_agent_api::client_action::Action;
+use warp_multi_agent_api::message::Message as MessageKind;
+use warp_multi_agent_api::response_event::Type;
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let config = Config::new(std::env::var("LLM_API_KEY")?);
+    let task_id = "bailian-smoke".to_owned();
+    let mut tasks: Vec<Task> = vec![];
+    for (prompt, expected) in [
+        (
+            "Remember the number 42 for this conversation. Reply only OK.",
+            "OK",
+        ),
+        (
+            "What number did I ask you to remember? Reply only with that number.",
+            "42",
+        ),
+    ] {
+        let started = Instant::now();
+        let mut first_text_ms = None;
+        let mut text = String::new();
+        let mut finished = false;
+        let mut stream = generate(
+            config.clone(),
+            task_id.clone(),
+            tasks.clone(),
+            vec![prompt.to_owned()],
+        );
+        while let Some(event) = stream.next().await {
+            match event?.r#type {
+                Some(Type::ClientActions(actions)) => {
+                    for action in actions.actions {
+                        match action.action {
+                            Some(Action::CreateTask(create)) => {
+                                tasks.push(create.task.ok_or("missing task")?)
+                            }
+                            Some(Action::AddMessagesToTask(add)) => tasks
+                                .first_mut()
+                                .ok_or("missing task")?
+                                .messages
+                                .extend(add.messages),
+                            Some(Action::AppendToMessageContent(append)) => {
+                                let message = append.message.ok_or("missing message")?;
+                                if let Some(MessageKind::AgentOutput(output)) = message.message {
+                                    first_text_ms
+                                        .get_or_insert_with(|| started.elapsed().as_millis());
+                                    text.push_str(&output.text);
+                                    let target = tasks
+                                        .first_mut()
+                                        .ok_or("missing task")?
+                                        .messages
+                                        .iter_mut()
+                                        .find(|candidate| candidate.id == message.id)
+                                        .ok_or("missing output")?;
+                                    if let Some(MessageKind::AgentOutput(current)) =
+                                        target.message.as_mut()
+                                    {
+                                        current.text.push_str(&output.text);
+                                    }
+                                }
+                            }
+                            _ => return Err("unexpected action in text-only PoC".into()),
+                        }
+                    }
+                }
+                Some(Type::Init(init)) if init.conversation_id.is_empty() => {}
+                Some(Type::Finished(_)) => finished = true,
+                _ => return Err("unexpected native event".into()),
+            }
+        }
+        if !finished || text.trim() != expected {
+            return Err("smoke response or completion check failed".into());
+        }
+        println!(
+            "model={MODEL} expected={expected} matched=true finished={finished} first_text_ms={} total_ms={}",
+            first_text_ms.unwrap_or_default(),
+            started.elapsed().as_millis()
+        );
+    }
+    Ok(())
+}
